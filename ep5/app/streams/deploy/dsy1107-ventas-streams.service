[Unit]
Description=DSY1107 EP5 - Procesador Kafka Streams de ventas
Documentation=https://github.com/krockzs/Evaluacion1-DSY1107/tree/ep5-app/ep5/app/streams
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/dsy1107-ep5/streams
EnvironmentFile=/home/ubuntu/dsy1107-ep5/streams/.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -XX:MaxDirectMemorySize=256m -jar /home/ubuntu/dsy1107-ep5/streams/target/ventas-streams-1.0.0.jar
Restart=on-failure
RestartSec=8
TimeoutStopSec=40
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
